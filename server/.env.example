# ============================================================
# Pulse server — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is git-ignored.
# ============================================================

# --- Express ---
PORT=5000

# --- PostgreSQL (local dev) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=donor_network

# --- JWT ---
# Generate a strong random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# --- Eligibility scheduler ---
# "node"  → node-cron calls restore_donor_eligibility() daily at midnight (use on Windows)
# "pgcron" → let the database pg_cron job do it (use on Linux/Docker where pg_cron is available)
ELIGIBILITY_SCHEDULER=node

# --- Notification provider ---
# "console" → print to terminal (default, no paid account needed for demo)
# "smtp"    → send real emails via Nodemailer
# "twilio"  → send real SMS via Twilio
NOTIFY_PROVIDER=console

# --- SMTP (used when NOTIFY_PROVIDER=smtp) ---
# For testing, create a free Mailtrap or Ethereal account.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Twilio (used when NOTIFY_PROVIDER=twilio) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Admin seed account ---
# Used by:  npm run seed:admin
# Never put the real password in this file once committed — override in .env only.
ADMIN_EMAIL=admin@pulse.test
ADMIN_PASSWORD=Admin@123
