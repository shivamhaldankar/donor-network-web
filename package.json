{
  "name": "pulse-donor-network",
  "version": "1.0.0",
  "private": true,
  "description": "Pulse blood & organ donor network — Monorepo entrypoint",
  "scripts": {
    "build": "npm --prefix web install && npm --prefix web run build && npm --prefix server install",
    "start": "npm --prefix server start",
    "server:install": "npm --prefix server install",
    "server:start": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "db:init": "npm --prefix server run db:init",
    "seed:admin": "npm --prefix server run seed:admin"
  }
}
